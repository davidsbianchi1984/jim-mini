<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{StaticResource JimGreenBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="WatchingChip" Foreground="{StaticResource JimGreenBrush}"
                           FontWeight="Bold" FontSize="12" />
            </StackPanel>
            <TextBlock x:Name="Greeting" FontSize="28" FontWeight="Bold" Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="WatchingSub"
                       Foreground="{StaticResource JimT2Brush}" FontSize="14" TextWrapping="Wrap" />
            <Button x:Name="RefreshButton" Click="OnRefresh"
                    Background="Transparent" FontSize="12"
                    Foreground="{StaticResource JimBrandABrush}" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="BaselineTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <ProgressRing x:Name="Loading" IsActive="True" Foreground="{StaticResource JimBrandABrush}"
                                  Width="24" Height="24" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Empty"
                               Foreground="{StaticResource JimT2Brush}" FontSize="13" Visibility="Collapsed"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="MetricsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4">
                                    <TextBlock Text="{Binding Metric}" Foreground="{StaticResource JimTxtBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Display}" Foreground="{StaticResource JimT2Brush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 0.58.0. The console has offered this since 0.4.3 and the
                 shells never did: a key set there was used there, and the
                 deployment's key used here, on the same profile. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="KeyHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="KeyLead" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <PasswordBox x:Name="KeyBox" />
                    <Button x:Name="SaveKeyButton" Click="OnSaveKey"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="InviteHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="InviteLead" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <PasswordBox x:Name="InviteBox" />
                    <Button x:Name="SaveInviteButton" Click="OnSaveInvite"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ModelTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ModelSub"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderPicked" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="LanguageTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="LanguageSub"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguagePicked" />
                    <ToggleSwitch x:Name="PreTranslateToggle"
                                  IsOn="True" Toggled="OnModeToggled" />
                    <TextBox x:Name="TranslateBox" />
                    <Button x:Name="TranslateButton" Click="OnTranslate"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="TranslateOut" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource JimTxtBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="TranslateEngine" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ImproveTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ImproveSub"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ImproveCategory" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ImproveMessage"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                    <ComboBox x:Name="ImproveRating" HorizontalAlignment="Stretch" />
                    <Button x:Name="SendImproveButton" Click="OnSendImprovement"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="ImproveThanks" Foreground="{StaticResource JimGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveTally" Foreground="{StaticResource JimT2Brush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveMineHeader" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimTxtBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="ImproveMine">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Ability is not a gate: the accessibility report door. Three
                 questions, none a diagnosis, sent with no token. The reviewer
                 row reads them back with the deployment's own token. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AccHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="AccLead"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <!-- The per-need statement the console makes, not just its form. -->
                    <TextBlock x:Name="AccNeedsTitle" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsList"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsMore" FontStyle="Italic"
                               Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="AccDoing" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <TextBox x:Name="AccWall" TextWrapping="Wrap" AcceptsReturn="True" Height="72" />
                    <TextBox x:Name="AccHelp" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <Button x:Name="AccSend" Click="OnSendAccessReport"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="AccThanks" Foreground="{StaticResource JimGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <PasswordBox x:Name="AccReviewerBox" />
                    <Button x:Name="AccLoad" Click="OnLoadAccessReports" FontSize="12" />
                    <TextBlock x:Name="AccEmpty" Foreground="{StaticResource JimT2Brush}" FontSize="11"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="AccReportsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Claim 11's user-specific model, in plain terms. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LearnedTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="AdaptationSummary" Foreground="{StaticResource JimT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl x:Name="AdaptationHelps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Condition}"
                                               Foreground="{StaticResource JimTxtBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Tally}" FontSize="12"
                                               Foreground="{StaticResource JimT2Brush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AdaptationDials" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <TextBlock x:Name="SealedText" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="AdaptationMethod" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <Button x:Name="RebuildButton"
                            Click="OnRebuildAdaptation"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- The offline fine-tune. A separate card from the adaptation
                 profile above it on purpose: that one is a profile that
                 conditions a prompt, this one is weights, and one card doing
                 both is how a reader ends up unable to say which they have. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="FtHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="FtSub" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="FtFrom" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="FtMethod" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <ToggleSwitch x:Name="FtUse" Toggled="OnUseTrainedModel"
                                  Visibility="Collapsed" />
                    <TextBlock x:Name="FtOff" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <Button x:Name="FtTrainButton" Click="OnTrainModel"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Spec [0031] / box 212: the tradeoff, not a switch. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="NameTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="AnonymityKnownAs" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <ItemsControl x:Name="AnonymityLines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT2Brush}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
