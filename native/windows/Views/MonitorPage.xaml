<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Sub"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <Slider x:Name="HeartRate" Minimum="40" Maximum="180" Value="72" />
                    <Slider x:Name="Stress" Minimum="0" Maximum="100" Value="20" />
                </StackPanel>
            </Border>

            <Button x:Name="SendButton" Height="46" HorizontalAlignment="Stretch"
                    Foreground="White" Click="OnSend">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <Border x:Name="ResultCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ResultTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ResultReason" Foreground="{StaticResource JimT2Brush}"
                               FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultSpecialist" Foreground="{StaticResource JimGreenBrush}"
                               FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ResultGuidance" Foreground="{StaticResource JimTxtBrush}"
                               FontSize="14" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultFirstAid" Foreground="{StaticResource JimTxtBrush}"
                               FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ResultPace" Foreground="{StaticResource JimAmberBrush}"
                               FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ResultRefs" Foreground="{StaticResource JimGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ResultProvenance" Foreground="{StaticResource JimT2Brush}"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- [0039]: guidance that went out gets asked about. Read from
                 /followup rather than the monitor reply, so a question opened
                 in an earlier session is still asked. -->
            <Border x:Name="FollowupCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FollowupQuestion" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="FollowupAbout" Foreground="{StaticResource JimT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="FollowupNote" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HelpedButton" Click="OnFollowupHelped"
                                Background="{StaticResource JimGreenBrush}" Foreground="Black" />
                        <Button x:Name="DidNotButton" Click="OnFollowupDidNot"
                                Background="{StaticResource JimAmberBrush}" Foreground="Black" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="AnsweredCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AnsweredTitle" FontWeight="Bold" FontSize="16" />
                    <TextBlock x:Name="AnsweredNext" Foreground="{StaticResource JimT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <!-- The spec's second door: not a tier, a list of people. -->
                    <ItemsControl x:Name="LiveOptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Who}" FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource JimTxtBrush}" />
                                    <TextBlock Text="{Binding Channel}" FontSize="12"
                                               Foreground="{StaticResource JimBrandABrush}" />
                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource JimT3Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LiveNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                </StackPanel>
            </Border>

            <!-- Clinical captures live with monitoring: what the body
                 shows, sealed beside what the body reports. -->
            <Border Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CapHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="CapFor" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <ComboBox x:Name="CapSite" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="CapNote" />
                    <ToggleSwitch x:Name="CapConsent" Visibility="Collapsed" />
                    <Button x:Name="CapPickButton" Click="OnPickCapture"
                            Background="{StaticResource JimBrandABrush}"
                            Foreground="White" FontSize="12" />
                    <ItemsControl x:Name="CapRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource JimTxtBrush}" />
                                    <TextBlock Text="{Binding Note}" FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource JimT2Brush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding ShowLabel}" Tag="{Binding Id}"
                                                Click="OnShowCapture" FontSize="11" />
                                        <Button Content="{Binding AttachLabel}" Tag="{Binding Id}"
                                                Click="OnAttachCapture" FontSize="11" />
                                        <Button Content="{Binding WithdrawLabel}" Tag="{Binding Id}"
                                                Click="OnWithdrawCapture" FontSize="11"
                                                Foreground="{StaticResource JimRedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Image x:Name="CapImage" MaxHeight="220" Visibility="Collapsed" />
                    <TextBlock x:Name="CapError" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
