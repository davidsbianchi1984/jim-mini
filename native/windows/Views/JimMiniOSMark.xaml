<?xml version="1.0" encoding="utf-8"?>
<!--
  The jim-mini OS lockup — the whole mark, as the ABRACADABRA menu button.

  Three stacked parts in the proportions of the artwork: the neon wordmark,
  the amulet triangle with ABRACADABRA descending eleven rows, and the OS
  plate. The console draws the same lockup from the same numbers
  (app/src/JimMiniOS.tsx, assets/brand/jim-mini-os.svg).

      asked     is the mark on the button
      mattered  is the whole mark on the button, big enough to read as itself

  Drawn at a fixed 100x100 inside a Viewbox rather than sized in pixels: the
  Viewbox is what lets one drawing be a 72px menu icon here and a 200px mark
  somewhere else without a second set of numbers to keep in step. Everything
  below is stock layout and one Polygon — no packaged image asset, so nothing
  has to be added to the .csproj and nothing can go missing from the package.
-->
<UserControl
    x:Class="JimGuardian.Views.JimMiniOSMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="ABRACADABRA">

    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100" Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The wordmark. A script face cannot be assumed to exist, so the
                 stack asks for one and degrades to a glowing italic word
                 rather than to something that looks broken. -->
            <TextBlock Grid.Row="0" Text="jim-mini" FontSize="15"
                       FontFamily="Segoe Script, Brush Script MT, Gabriola"
                       FontStyle="Italic" Foreground="#E9F04E"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Grid Grid.Row="1" Width="42" HorizontalAlignment="Center">
                <Polygon Points="0,0 42,0 21,37" Fill="#15120A"
                         StrokeThickness="2.1" StrokeLineJoin="Round">
                    <Polygon.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#DFE94B" Offset="0" />
                            <GradientStop Color="#F2C230" Offset="0.5" />
                            <GradientStop Color="#B8861F" Offset="1" />
                        </LinearGradientBrush>
                    </Polygon.Stroke>
                </Polygon>
                <!-- The descent stops above the apex, as on the amulet: eleven
                     rows over the top ~78% of the triangle. -->
                <StackPanel x:Name="Descent" Margin="0,1,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="2" Background="White" Width="82" Height="21"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,1,0,0">
                <TextBlock Text="OS" FontSize="17" FontWeight="Black"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
