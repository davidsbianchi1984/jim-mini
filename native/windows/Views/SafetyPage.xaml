<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.SafetyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource JimTxtBrush}">

        <!-- Alarms. First, and therefore the pivot that opens: somebody
             reaching this page has usually just been paged, and the thing they
             were paged about should not be behind a header they have to find. -->
        <PivotItem x:Name="AlarmsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <TextBlock x:Name="AlarmsEmpty" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}"
                               />

                    <ItemsControl x:Name="AlarmsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}"
                                        CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Raised}" FontWeight="Bold"
                                                   Foreground="{StaticResource JimRedBrush}" />
                                        <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource JimTxtBrush}" />
                                        <!-- The page has carried this sentence since it
                                             shipped, at the very bottom in caption grey.
                                             On an open alarm it is the thing to do first,
                                             so it sits on the card. Empty string when the
                                             row does not claim it, which is never today
                                             and is the row's call to make, not this
                                             template's. -->
                                        <TextBlock Text="{Binding CannotDial}" FontSize="13"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource JimRedBrush}" />
                                        <!-- Accepted is not cleared: the server says
                                             so and this shell repeats it rather than
                                             greying the card out. -->
                                        <TextBlock Text="{Binding Attending}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource JimAmberBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A named responder, because the backend refuses an empty
                         one: "someone accepted it" is the thing this relay
                         exists to stop being enough. -->
                    <TextBox x:Name="ResponderBox" />
                    <Button x:Name="AcceptButton" Click="OnAcceptAlarm"
                            HorizontalAlignment="Stretch"
                            />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EscalateButton" Click="OnEscalateAlarm"
                                />
                        <Button x:Name="ClearAlarmButton" Click="OnClearAlarm"
                                />
                    </StackPanel>

                    <TextBox x:Name="AlarmQuestionBox" />
                    <Button x:Name="AlarmAskButton" Click="OnAskAlarmGuidance" />
                    <TextBlock x:Name="AlarmGuidanceText" TextWrapping="Wrap"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="AlarmSaid" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="AlarmNotEmergency" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource JimT2Brush}" />

                    <!-- The sticker and the relay: beacons a stranger can
                         scan, and the relay that escalates people. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="BcnHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="BcnPitch" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <!-- Named for what it is: the bystander's path,
                                 not yours. -->
                            <TextBlock x:Name="BcnBystander" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <StackPanel x:Name="BcnRows" Spacing="4" />
                            <TextBlock x:Name="BcnCardName" FontWeight="Bold" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="BcnCardNote" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="BcnCardBadge" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <Button x:Name="BcnRaiseButton" Click="OnRaiseBeaconAlarm" Visibility="Collapsed"
                                    Background="Transparent" FontSize="12"
                                    Foreground="{StaticResource JimRedBrush}" />
                            <TextBlock x:Name="BcnAlarmLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <TextBox x:Name="BcnLabel" />
                            <TextBox x:Name="BcnWhere" />
                            <Button x:Name="BcnPlaceButton" Click="OnPlaceBeacon" Foreground="White"
                                    Background="{StaticResource JimBrandABrush}" />

                            <TextBlock x:Name="RelHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="RelChannel" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="RelChannelNote" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="RelRoster" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="RelRota" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="BcnError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- SOS -->
        <PivotItem x:Name="SosPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Button x:Name="SosButton" HorizontalAlignment="Stretch" Height="96"
                            Background="{StaticResource JimRedBrush}" Foreground="White"
                            Click="OnSos">
                        <StackPanel>
                            <TextBlock x:Name="SosLabel" FontSize="30" FontWeight="Black"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SosHint" FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="SituationBox" />
                            <TextBox x:Name="LocationBox" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SosError" Foreground="{StaticResource JimRed}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="FlowList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                                   Foreground="{StaticResource JimTxtBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{StaticResource JimT2Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Crash watch -->
        <PivotItem x:Name="CrashPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border x:Name="CrashAskingCard" Visibility="Collapsed"
                            Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimAmberBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CrashAskingTitle" FontWeight="Bold"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="CrashAskingDetail" Foreground="{StaticResource JimT2Brush}"
                                       FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="ImOkayButton" Click="OnImOkay" HorizontalAlignment="Stretch"
                                    Background="{StaticResource JimGreenBrush}" Foreground="Black" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CrashTrippedNote" Visibility="Collapsed" FontSize="12"
                               Foreground="{StaticResource JimRedBrush}" TextWrapping="Wrap" />
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="CrashHead" FontWeight="Bold"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="CrashSub"
                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBox x:Name="CrashName" />
                            <TextBox x:Name="CrashChannel" />
                            <NumberBox x:Name="CrashAttempts" Value="3"
                                       Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" />
                            <NumberBox x:Name="CrashWindow" Value="5"
                                       Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                            <CheckBox x:Name="CrashEms"
                                      />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="CrashArmButton" Click="OnCrashArm" />
                                <Button x:Name="CrashDisarmButton" Click="OnCrashDisarm"
                                        Visibility="Collapsed" Foreground="{StaticResource JimRedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="CrashArmedNote" Visibility="Collapsed" FontSize="12"
                                       Foreground="{StaticResource JimGreenBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CrashError" Visibility="Collapsed" FontSize="12"
                               Foreground="{StaticResource JimRedBrush}" TextWrapping="Wrap" />

                    <!-- The vigil is the crash watch's chronic sibling: one
                         fires on a bad reading, the other on no readings at
                         all. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="VgHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="VgPitch" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="VgTrippedNote" FontWeight="Bold" FontSize="12"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <Button x:Name="VgOkayButton" Click="OnVigilOkay" Visibility="Collapsed"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource JimGreenBrush}" Foreground="Black" />
                            <TextBlock x:Name="VgArmedNote" FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource JimGreenBrush}" />
                            <TextBox x:Name="VgName" />
                            <TextBox x:Name="VgChannel" />
                            <NumberBox x:Name="VgDays" Value="3" Minimum="0.5" Maximum="30"
                                       SpinButtonPlacementMode="Inline" />
                            <TextBox x:Name="VgWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="VgArmButton" Click="OnVigilArm" />
                                <Button x:Name="VgDisarmButton" Click="OnVigilDisarm"
                                        Visibility="Collapsed" Foreground="{StaticResource JimRedBrush}" />
                                <Button x:Name="VgCheckButton" Click="OnVigilCheck" />
                            </StackPanel>
                            <TextBlock x:Name="VgError" FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Medical ID -->
        <PivotItem x:Name="MedPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="MedHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MedSub"
                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="IssueButton" HorizontalAlignment="Stretch"
                                    Height="42" Foreground="White" Click="OnIssueCard">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MedError" Foreground="{StaticResource JimRed}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border x:Name="MedCard" Background="{StaticResource JimCardBrush}"
                            BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="IssuedHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimGreenBrush}" />
                            <TextBlock x:Name="PrintHint"
                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" />
                            <TextBlock x:Name="QrUrlText" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource JimT2Brush}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="MedRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,2">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource JimT2Brush}"
                                                       FontSize="12" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource JimTxtBrush}"
                                                       FontSize="12" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RevokeCardButton" Click="OnRevokeCard"
                                    Background="Transparent" Foreground="{StaticResource JimRed}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Policy -->
        <PivotItem x:Name="PolicyPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <ComboBox x:Name="SensitivityBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnSensitivityPicked">
                                <ComboBoxItem x:Name="SensCautious" />
                                <ComboBoxItem x:Name="SensBalanced" />
                                <ComboBoxItem x:Name="SensAssertive" />
                            </ComboBox>
                            <TextBlock x:Name="SensSub"
                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="PolicyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4">
                                    <TextBlock Text="{Binding Severity}" Foreground="{StaticResource JimTxtBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Tier}" Foreground="{StaticResource JimBrandABrush}"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The far end of the ladder (jim/farend.py): the address
                         alerts really go to, or the honest refusal that nobody
                         stands there — and whether a person saw the last one.
                         The console's Held card, carried here as the backlog
                         promised. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="FarEndHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="FarEndStatusText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="FarEndAlertText" FontSize="12" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="FarEndEmailBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="FarEndSaveButton" Click="OnFarEndSave"
                                        Background="{StaticResource JimBrandABrush}" Foreground="White" />
                                <Button x:Name="FarEndClearButton" Click="OnFarEndClear" />
                            </StackPanel>
                            <TextBlock x:Name="FarEndPitch" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Robots -->
        <PivotItem x:Name="RobotsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <ComboBox x:Name="RobotModelBox" HorizontalAlignment="Stretch" />
                            <Button x:Name="BindButton" HorizontalAlignment="Stretch"
                                    Height="42" Foreground="White" Click="OnBind">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <TextBlock x:Name="RobotsSub"
                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Name="WaiverHead" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource JimTxtBrush}" />
                                <TextBlock x:Name="WaiverBadge" HorizontalAlignment="Right"
                                           FontSize="11" FontWeight="Bold" Visibility="Collapsed"
                                           Foreground="{StaticResource JimGreenBrush}" />
                            </Grid>
                            <TextBlock x:Name="WaiverBlurb" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="WaiverTerms" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="SignatureBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SignWaiverButton" Click="OnSignWaiver"
                                        Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                                <Button x:Name="RevokeWaiverButton"
                                        Click="OnRevokeWaiver" Visibility="Collapsed"
                                        Background="Transparent" FontSize="12"
                                        Foreground="{StaticResource JimRedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RobotError" Foreground="{StaticResource JimRed}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="RobotCmdResult" Foreground="{StaticResource JimGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="RobotsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           Foreground="{StaticResource JimTxtBrush}" />
                                                <TextBlock Text="{Binding Rating}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource JimGreenBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource JimT2Brush}" FontSize="12" />
                                        </Grid>
                                        <TextBlock Text="{Binding Directive}" FontSize="12"
                                                   Foreground="{StaticResource JimT2Brush}" />
                                        <Button Content="{Binding UnbindLabel}" Tag="{Binding Id}"
                                                Click="OnUnbindRobot" Background="Transparent" FontSize="11"
                                                Foreground="{StaticResource JimRedBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding AssistVisibility}">
                                            <Button Content="{Binding AedLabel}" Tag="{Binding Id}" Click="OnFetchAed"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="11" />
                                            <Button Content="{Binding CoachLabel}" Tag="{Binding Id}" Click="OnCoachCpr"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="11" />
                                            <Button Content="{Binding EmsLabel}" Tag="{Binding Id}" Click="OnMeetEms"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding PerformVisibility}">
                                            <Button Content="{Binding PerformLabel}" Tag="{Binding Id}" Click="OnPerformCpr"
                                                    Visibility="{Binding ConfirmGateVisibility}"
                                                    Background="{StaticResource JimRedBrush}" Foreground="White" FontSize="11" />
                                            <Button Content="{Binding StartLabel}" Tag="{Binding Id}" Click="OnAutoCpr"
                                                    Visibility="{Binding WaivedVisibility}"
                                                    Background="{StaticResource JimRedBrush}" Foreground="White" FontSize="11" />
                                            <Button Content="{Binding AutoLabel}" Tag="{Binding Id}" Click="OnAutoDefib"
                                                    Visibility="{Binding WaivedVisibility}"
                                                    Background="{StaticResource JimRedBrush}" Foreground="White" FontSize="11" />
                                            <Button Content="{Binding StopLabel}" Tag="{Binding Id}" Click="OnStopCpr"
                                                    Visibility="{Binding StopVisibility}"
                                                    Background="{StaticResource JimRedBrush}" Foreground="White" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="ConfirmCprButton" Visibility="Collapsed" Click="OnConfirmCpr"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource JimRedBrush}" Foreground="White" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
