<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.LifePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource JimTxtBrush}">

        <!-- Goals -->
        <PivotItem x:Name="GoalsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <ComboBox x:Name="GoalArea" Header="Area" SelectedIndex="5" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="mental_health" />
                                <ComboBoxItem Content="health_fitness" />
                                <ComboBoxItem Content="career" />
                                <ComboBoxItem Content="finance" />
                                <ComboBoxItem Content="relationships" />
                                <ComboBoxItem Content="personal_growth" />
                            </ComboBox>
                            <TextBox x:Name="GoalTitle" Header="Title" PlaceholderText="What do you want to achieve?" />
                            <Button Content="Add goal" HorizontalAlignment="Stretch" Height="42"
                                    Foreground="White" Click="OnAddGoal">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ActHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="ActPitch" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="ActWhat" />
                            <TextBox x:Name="ActNote" />
                            <Button x:Name="ActLogButton" Click="OnActivityLog" Foreground="White"
                                    Background="{StaticResource JimBrandABrush}" />
                            <TextBlock x:Name="ActIntervention" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="ActError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="GoalsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   Foreground="{StaticResource JimTxtBrush}" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource JimT2Brush}" FontSize="12" />
                                        <Button Content="{Binding DoneLabel}" Tag="{Binding Id}"
                                                Click="OnGoalDone" Visibility="{Binding DoneVisibility}"
                                                Background="Transparent" FontSize="12"
                                                Foreground="{StaticResource JimGreenBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Habits -->
        <PivotItem x:Name="HabitsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="HabitName" Header="Name" PlaceholderText="e.g. Walk 20 minutes" />
                            <Button Content="Add habit" HorizontalAlignment="Stretch" Height="42"
                                    Foreground="White" Click="OnAddHabit">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="HabitsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{StaticResource JimTxtBrush}" />
                                            <TextBlock Text="{Binding Streak}" Foreground="{StaticResource JimT2Brush}" FontSize="12" />
                                        </StackPanel>
                                        <Button Content="Log" Tag="{Binding Id}" Click="OnLogHabit"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{StaticResource JimBrandABrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Journal -->
        <PivotItem x:Name="JournalPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="JournalText" Header="Entry" PlaceholderText="How was today?"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                            <Button Content="Save entry" HorizontalAlignment="Stretch" Height="42"
                                    Foreground="White" Click="OnAddJournal">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="JournalList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource JimTxtBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Date}" Foreground="{StaticResource JimT2Brush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Money: the guardian that watches balances. No literal strings
             here on purpose — every header, placeholder and button below is
             set in code-behind from the overview's own `labels`, composed
             server-side in the reader's language, because the English count
             behind this shell's tabs is a ratchet this page must not feed. -->
        <PivotItem x:Name="MoneyPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MoneyTitle" FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MoneyNote" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="MoneyAccounts">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimTxtBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Balance}" Foreground="{StaticResource JimT2Brush}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="MoneyInstitution" />
                            <PasswordBox x:Name="MoneyAccountNumber" />
                            <PasswordBox x:Name="MoneyRoutingNumber" />
                            <Button x:Name="MoneyAddButton" HorizontalAlignment="Stretch" Height="42"
                                    Foreground="White" Click="OnMoneyAdd">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MoneyObserveTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBox x:Name="MoneyBalance" />
                            <Button x:Name="MoneyObserveButton" HorizontalAlignment="Stretch"
                                    Click="OnMoneyObserve" />
                            <TextBlock x:Name="MoneyWarningsText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="MoneyDoorsText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MoneySavingsTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MoneySavingsCurrent" FontSize="12"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="MoneyGoal" />
                            <Button x:Name="MoneyGoalButton" HorizontalAlignment="Stretch"
                                    Click="OnMoneySetGoal" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MoneyMandateTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBox x:Name="MoneyScope" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MoneyMandateButton" Click="OnMoneyMandate" />
                                <Button x:Name="MoneyRevokeButton" Click="OnMoneyRevoke" />
                            </StackPanel>
                            <TextBlock x:Name="MoneyOrdersText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="MoneyStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="BudHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="BudNone" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <StackPanel x:Name="BudRows" Spacing="4" />
                            <TextBox x:Name="BudCategory" />
                            <Slider x:Name="BudLimit" Minimum="10" Maximum="2000" Value="100"
                                    StepFrequency="10" />
                            <Button x:Name="BudSetButton" Click="OnSetBudget" Foreground="White"
                                    Background="{StaticResource JimBrandABrush}" />
                            <TextBlock x:Name="BudError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Schedule and the tandem shops shelf. As with Money: no literal
             strings — every header and button is set in code-behind from
             the views' own labels, composed server-side in the reader's
             language. -->
        <PivotItem x:Name="SchedulePivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ScheduleNote" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="ApptTitle" />
                            <TextBox x:Name="ApptWhen" />
                            <TextBox x:Name="ApptWhere" />
                            <CheckBox x:Name="ApptEmail" />
                            <Button x:Name="BookButton" HorizontalAlignment="Stretch"
                                    Click="OnBook" />
                            <ItemsControl x:Name="ApptList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimT2Brush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="CancelApptId" />
                            <Button x:Name="CancelApptButton" Click="OnCancelAppt" />
                            <TextBlock x:Name="ScheduleStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>

                    <!-- The dose board is a schedule the body keeps. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MedHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MedMissed" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="MedToday" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="MedNone" FontSize="11" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <StackPanel x:Name="MedRows" Spacing="6" />
                            <TextBlock x:Name="MedDisclaimer" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MedAdherenceButton" Click="OnMedAdherence" />
                                <Button x:Name="MedAddToggle" Click="OnMedAddToggle" />
                            </StackPanel>
                            <StackPanel x:Name="MedAdherenceRows" Spacing="2" Visibility="Collapsed" />
                            <StackPanel x:Name="MedAddForm" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="MedAddPitch" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT2Brush}" />
                                <TextBox x:Name="MedName" />
                                <TextBox x:Name="MedDose" />
                                <TextBox x:Name="MedPurpose" />
                                <CheckBox x:Name="MedAsNeeded" Click="OnMedAsNeededToggle" />
                                <TextBox x:Name="MedTimes" PlaceholderText="08:00, 20:00" />
                                <TextBox x:Name="MedCeiling" PlaceholderText="3" Visibility="Collapsed" />
                                <CheckBox x:Name="MedCritical" />
                                <Button x:Name="MedAddButton" HorizontalAlignment="Stretch"
                                        Click="OnMedAdd" />
                            </StackPanel>
                            <TextBlock x:Name="MedError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem x:Name="ShopPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ShopNote" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="TandemShopList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimTxtBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="OrderShopId" />
                            <TextBox x:Name="OrderOffering" />
                            <Button x:Name="TandemOrderButton" Click="OnTandemOrder" />
                            <ItemsControl x:Name="ReceiptList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimT2Brush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="CancelOrderId" />
                            <Button x:Name="TandemCancelButton" Click="OnTandemCancel" />
                            <TextBlock x:Name="ShopStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Your circle. As above: no literal strings — every header and
             button is set in code-behind from the view's own labels. -->
        <PivotItem x:Name="CirclePivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CircleNote" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="CirclePeople">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimTxtBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="InviteId" />
                            <Button x:Name="InviteButton" Click="OnCircleInvite" />
                            <Button x:Name="LeaveButton" Click="OnCircleLeave" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <ItemsControl x:Name="CircleThreads">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimTxtBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="DmWith" />
                            <Button x:Name="OpenThreadButton" Click="OnCircleOpenThread" />
                            <ItemsControl x:Name="CircleThreadList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" Foreground="{StaticResource JimT2Brush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="DmDraft" />
                            <Button x:Name="DmSendButton" Click="OnCircleSend" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="MessagingSwitch" Toggled="OnMessagingSwitch" />
                            <ToggleSwitch x:Name="HomepageSwitch" Toggled="OnHomepageSwitch" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="PageHeadline" />
                            <TextBox x:Name="PageAbout" />
                            <TextBox x:Name="PageBg" />
                            <TextBox x:Name="PageAccent" />
                            <Button x:Name="PageSaveButton" Click="OnCircleSavePage" />
                            <TextBox x:Name="VisitId" />
                            <Button x:Name="VisitButton" Click="OnCircleVisit" />
                            <TextBlock x:Name="VisitedPage" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="CircleStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
