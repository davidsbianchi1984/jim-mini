<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JimGuardian.Views"
    Background="{StaticResource JimScrBotBrush}">

    <!-- Every item carries its icon inside `Content` rather than in the
         `Icon` slot. `NavigationViewItem.Icon` takes an `IconElement`, which
         cannot be a drawing and cannot be resized; the ABRACADABRA item is a
         drawing, and once one item is 56px the rest have to be too or the
         menu has one button that got away. A `Viewbox` does for the eleven
         symbols what the mark does for itself.

         The trade this makes: with the icons in `Content`, a collapsed pane
         would have nothing to show. `PaneDisplayMode="Left"` keeps the pane
         expanded, which is what this shell already asked for. -->
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" SelectionChanged="OnSelectionChanged"
                    Background="{StaticResource JimScrBotBrush}">
        <NavigationView.MenuItems>
            <NavigationViewItem Tag="overview" Height="72" IsSelected="True">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Home" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="monitor" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Important" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="checkin" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Emoji2" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="coach" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Message" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="engaged" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <local:JimMiniOSMark Width="56" Height="56" />
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="presence" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Contact" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="life" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Flag" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="safety" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="ReportHacked" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="connect" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Link" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="custody" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Permissions" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="family" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="People" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="self" Height="72">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="56" Height="56"><SymbolIcon Symbol="Contact" /></Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="SignOutButton" Margin="12" Click="OnSignOut"
                    Foreground="{StaticResource JimT2Brush}" Background="Transparent" />
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
