<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.CustodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="740" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Sub"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <!-- What this deployment can and cannot reach. Read-only: the
                 posture is set in the deployment's environment, not by
                 somebody signed into the app. -->
            <Border x:Name="OfflineCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="OfflineTitle" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OfflineState" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimGreenBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OfflineLocal" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="OfflineGuarantees" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ChainText" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource JimGreenBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyNote"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="8">
                <ListView x:Name="RecordsList" SelectionMode="Single"
                          SelectionChanged="OnSelect" />
            </Border>

            <Border x:Name="ProvCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ProvTitle" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProvText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <!-- The portability door. Counts on the desktop shell; the
                 document itself is what the console downloads. -->
            <!-- Every string here is set from L10n in the constructor. A
                 literal in this file is English behind a translated tab bar,
                 which the guard next door counts. -->
            <TextBlock x:Name="TakeItHead" FontWeight="Bold" FontSize="14"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="TakeItPitch" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource JimT2Brush}" />
            <Button x:Name="TakeItButton" Height="40" Click="OnTakeItWithYou" />
            <!-- The exit. Armed only by the word itself: there is no undo
                 behind it, which is the point of it. -->
            <TextBlock x:Name="EndItHead" FontWeight="Bold" FontSize="14"
                       Foreground="{StaticResource JimRedBrush}" />
            <TextBlock x:Name="EndItPitch" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource JimT2Brush}" />
            <TextBox x:Name="EndItBox" Height="40" TextChanged="OnEndItTyped" />
            <Button x:Name="EndItButton" Height="40" IsEnabled="False"
                    Click="OnEndIt" />
            <Button x:Name="RefreshButton" Height="40" Click="OnRefresh"
                    Foreground="White" Background="{StaticResource JimBrandABrush}" />
            <!-- The notice that has to be answered before anything leaves this
                 machine, and the switch that turns it off afterwards. The
                 preview below is built by Problems.Report — the same function
                 the sender posts — so what is shown is the payload rather than
                 a description of it. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BreaksHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ProblemsExplain" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="ProblemsAsk" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ProblemsYes" Click="OnProblemsYes" />
                        <Button x:Name="ProblemsNo" Click="OnProblemsNo" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ProblemsSwitch"
                                  Toggled="OnProblemsToggled" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="ProblemsPreviewButton"
                                     Click="OnProblemsPreview" />
                    <TextBlock x:Name="ProblemsPreview" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="ProblemsServerTitle" FontWeight="SemiBold"
                               FontSize="13" Foreground="{StaticResource JimTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="ProblemsKeyBox" Width="220" />
                        <Button x:Name="ProblemsFetchButton" Click="OnProblemsFetch" />
                    </StackPanel>
                    <TextBlock x:Name="ProblemsServerRows" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <!-- Who read it, where answers come from, what leaves, what went
                 out in your name. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VeilLogHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="VeilVaulted" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="VeilLogState" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel x:Name="VeilLogEntries" Spacing="2" />
                    <TextBlock x:Name="VeilLogNote" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />

                    <!-- The other half of the same question: what was done,
                         and whether the saying of it has been edited since.
                         The chain's state sits above the rows because a list
                         nobody can check is a list, not a record. -->
                    <TextBlock x:Name="VeilAuditHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="VeilAuditChain" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="VeilAuditState" FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel x:Name="VeilAuditEntries" Spacing="2" />
                    <TextBlock x:Name="VeilAuditRetention" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />

                    <TextBlock x:Name="VeilWhereHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="VeilCloudLine" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilCloudNote" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />

                    <TextBlock x:Name="VeilCloudHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilPolicy" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <Button x:Name="VeilStopButton" Click="OnStopContributing" Visibility="Collapsed"
                            Background="Transparent" FontSize="12"
                            Foreground="{StaticResource JimRedBrush}" />
                    <TextBlock x:Name="VeilRevoked" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />

                    <TextBlock x:Name="VeilPagesHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilPagesPitch" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <TextBlock x:Name="VeilPagesNone" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel x:Name="VeilPages" Spacing="2" />
                    <TextBlock x:Name="VeilHistoryHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilHistoryNone" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel x:Name="VeilIncidents" Spacing="2" />

                    <TextBlock x:Name="VeilLocHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilLocPitch" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="VeilLocBox" MinWidth="180" />
                        <Button x:Name="VeilLocSave" Click="OnSaveLocality"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="VeilLocSaved" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />

                    <TextBlock x:Name="VeilPlanHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VeilPlanCurrent" FontWeight="Bold" FontSize="12" Visibility="Collapsed"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="VeilPlanMeans" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <TextBlock x:Name="VeilPlanReaders" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="VeilPlans" Spacing="2" />
                    <Button x:Name="VeilPlanCancel" Click="OnCancelMembership"
                            Background="Transparent" FontSize="12"
                            Foreground="{StaticResource JimRedBrush}" />
                    <TextBlock x:Name="VeilError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimRedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
