<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.FamilyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="IntroText"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="ChildName" />
                    <TextBox x:Name="ChildBirthdate" />
                    <TextBox x:Name="GuardianPhone" />
                    <Button x:Name="CreateButton" Height="42"
                            HorizontalAlignment="Stretch" Click="OnCreate"
                            Foreground="White" Background="{StaticResource JimBrandABrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource JimRedBrush}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="CreatedCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CreatedTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="CreatedMeta" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TokenLabel"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource JimAmberBrush}" />
                    <TextBlock x:Name="CreatedToken" FontSize="11" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{StaticResource JimTxtBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="WatchCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="WatchTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="WatchText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <ListView x:Name="KidsList" SelectionMode="Single" SelectionChanged="OnSelect" />

            <Border x:Name="ControlsCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ControlsTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ControlsSub"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <ToggleSwitch x:Name="PauseToggle"
                                  Foreground="{StaticResource JimTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="QuietStartBox" Width="180" />
                        <TextBox x:Name="QuietEndBox" Width="180" />
                    </StackPanel>
                    <Button x:Name="ApplyButton" Click="OnApplyControls"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="ControlsNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimGreenBrush}" Visibility="Collapsed" />

                    <!-- Ending the link. This page could begin one and not end
                         one; the confirm is the two-step reveal this shell
                         already uses before an irreversible act, rather than a
                         dialog, so the sentence about what is *not* deleted is
                         on screen while the decision is made. -->
                    <Border Height="1" Background="{StaticResource JimLineBrush}"
                            Margin="0,6" />
                    <Button x:Name="UnlinkButton" Click="OnUnlinkAsked"
                            HorizontalAlignment="Left" Background="Transparent"
                            FontSize="12" FontWeight="Bold"
                            Foreground="{StaticResource JimRedBrush}" />
                    <StackPanel x:Name="UnlinkConfirmPanel" Spacing="6"
                                Visibility="Collapsed">
                        <TextBlock x:Name="UnlinkAsk" FontWeight="Bold" FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource JimTxtBrush}" />
                        <TextBlock x:Name="UnlinkTheirs" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource JimT2Brush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UnlinkConfirmButton" Click="OnUnlinkConfirmed"
                                    Background="{StaticResource JimRedBrush}"
                                    Foreground="White" FontSize="12" />
                            <Button x:Name="KeepLinkButton" Click="OnKeepLink"
                                    FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="UnlinkNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="OverviewCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="OverviewTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="OverviewText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <!-- The care team: the household's coordination layer, linked
                 from the same screen that watches over its members. -->
            <Border Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CtHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="CtSub" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="CtLinkForm" Spacing="8">
                        <TextBlock x:Name="CtPitch" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource JimT2Brush}" />
                        <TextBox x:Name="CtOrg" />
                        <TextBox x:Name="CtDept" />
                        <PasswordBox x:Name="CtToken" />
                        <Button x:Name="CtLinkButton" Click="OnCareTeamLink"
                                Background="{StaticResource JimBrandABrush}"
                                Foreground="White" FontSize="12" />
                    </StackPanel>
                    <StackPanel x:Name="CtLinked" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="CtLinkedHead" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource JimGreenBrush}" />
                        <TextBlock x:Name="CtLinkedPitch" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource JimT2Brush}" />
                        <TextBlock x:Name="CtLinkedLine" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource JimT2Brush}" />
                        <TextBox x:Name="CtGoal" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CtCoordinateButton" Click="OnCareTeamCoordinate"
                                    Background="{StaticResource JimBrandABrush}"
                                    Foreground="White" FontSize="12" />
                            <Button x:Name="CtUnlinkButton" Click="OnCareTeamUnlink"
                                    Background="{StaticResource JimRedBrush}"
                                    Foreground="White" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="CtPlansEmpty" FontSize="11"
                                   Foreground="{StaticResource JimT3Brush}" />
                        <ItemsControl x:Name="CtPlans">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Text="{Binding Goal}" FontWeight="Bold"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource JimTxtBrush}" />
                                        <TextBlock Text="{Binding Plan}" FontSize="11"
                                                   TextWrapping="Wrap" MaxLines="4"
                                                   Foreground="{StaticResource JimT2Brush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="CtError" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
