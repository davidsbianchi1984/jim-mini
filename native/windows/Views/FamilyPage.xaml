<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.FamilyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="IntroText"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="ChildName" />
                    <TextBox x:Name="ChildBirthdate" />
                    <TextBox x:Name="GuardianPhone" />
                    <Button x:Name="CreateButton" Height="42"
                            HorizontalAlignment="Stretch" Click="OnCreate"
                            Foreground="White" Background="{StaticResource JimBrandABrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource JimRedBrush}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="CreatedCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CreatedTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="CreatedMeta" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TokenLabel"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource JimAmberBrush}" />
                    <TextBlock x:Name="CreatedToken" FontSize="11" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{StaticResource JimTxtBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="WatchCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="WatchTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="WatchText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <ListView x:Name="KidsList" SelectionMode="Single" SelectionChanged="OnSelect" />

            <Border x:Name="ControlsCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ControlsTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ControlsSub"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <ToggleSwitch x:Name="PauseToggle"
                                  Foreground="{StaticResource JimTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="QuietStartBox" Width="180" />
                        <TextBox x:Name="QuietEndBox" Width="180" />
                    </StackPanel>
                    <Button x:Name="ApplyButton" Click="OnApplyControls"
                            Background="{StaticResource JimBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="ControlsNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimGreenBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="OverviewCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="OverviewTitle" FontWeight="Bold"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="OverviewText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
