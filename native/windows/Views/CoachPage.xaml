<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.CoachPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="CoachTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="CoachPitch"
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <ComboBox x:Name="AreaBox" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="MessageBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                    <Button x:Name="AskButton" HorizontalAlignment="Stretch"
                            Height="44" Foreground="White" Click="OnAsk">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource JimRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="ReplyCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ReplyHead" FontWeight="Bold" FontSize="16" Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ReplyProvenance" Foreground="{StaticResource JimT2Brush}"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ReplyText" Foreground="{StaticResource JimTxtBrush}"
                               FontSize="14" TextWrapping="Wrap" />

                    <!-- A specialist covers this area. An offer, not a send:
                         what would cross the tandem is what this person just
                         wrote, so the button is theirs and the note says so
                         before they press it. -->
                    <StackPanel x:Name="OfferPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="OfferLabel" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="OfferNote" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource JimT2Brush}" />
                        <Button x:Name="AskSpecialistButton"
                                Click="OnAskSpecialist" Background="Transparent"
                                Foreground="{StaticResource JimBrandABrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="SpecialistCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SpecialistWho" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SpecialistText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="SpecialistProv" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <!-- The Guardian's bearing: tone, what it was told, whether its
                 answers landed, and what it made of that. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ToneHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="ToneBox" SelectedIndex="1" />
                        <Button x:Name="ToneGoButton" Click="OnSetTone"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                    </StackPanel>

                    <TextBlock x:Name="ToldHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <ComboBox x:Name="ConditionBox" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ConditionNote" />
                    <Button x:Name="TellButton" Click="OnTellCondition" Foreground="White"
                            Background="{StaticResource JimBrandABrush}" />
                    <TextBlock x:Name="KnownLine" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="ContextSource" MinWidth="160" />
                        <Button x:Name="ContextButton" Click="OnGiveContext"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                        <Button x:Name="SayButton" Click="OnSaySomething"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="RefusedLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimAmberBrush}" />
                    <TextBlock x:Name="SaidLine" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />

                    <TextBlock x:Name="TellUsHead" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="GoodButton" Click="OnRateGood"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimGreenBrush}" />
                        <Button x:Name="BadButton" Click="OnRateBad"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimRedBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="MadeHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="MadeStats" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="InsightLines" Spacing="2" />
                    <TextBlock x:Name="BearingError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimRedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
