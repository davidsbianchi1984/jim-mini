<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.SelfProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="740" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="LeadText" Foreground="{StaticResource JimT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />

            <!-- What the Guardian carries between sessions. The console's
                 profile is a snapshot somebody rebuilds; this is the part
                 that moves on its own, and until this release nothing moved
                 at all because the only builder was a console button. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ContTitle" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="ContCount" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource JimTxtBrush}" />
                        <Button x:Name="ContForget" Click="OnForgetContinuity"
                                Foreground="{StaticResource JimRedBrush}"
                                Background="Transparent" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="ContState" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="ContDims" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="ContCarries" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="MemTitle" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MemLead" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="MemNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <ItemsControl x:Name="MemList" />
                </StackPanel>
            </Border>

            <!-- Signing in comes first; the paste-it form is behind a toggle.
                 The token that form asks for is minted once, in QRME's create
                 response, so somebody who made the profile elsewhere could
                 not fill it in at all. -->
            <StackPanel x:Name="SignInPanel" Spacing="8">
                <TextBlock x:Name="SignInHeading" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource JimTxtBrush}" />
                <TextBlock x:Name="SignInPitch" Foreground="{StaticResource JimT2Brush}"
                           FontSize="13" TextWrapping="Wrap" />
                <TextBox x:Name="QrmeEmailBox" />
                <PasswordBox x:Name="QrmePasswordBox" />
                <Button x:Name="SignInButton" Click="OnSignIn" />
                <TextBlock x:Name="ChooseText" Foreground="{StaticResource JimT2Brush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                <ComboBox x:Name="ChooseBox" Visibility="Collapsed" />
                <Button x:Name="ChooseButton" Click="OnChooseProfile"
                        Visibility="Collapsed" />
                <Button x:Name="PasteInsteadButton" Click="OnTogglePaste" />
            </StackPanel>

            <StackPanel x:Name="LinkPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="LinkHeading" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource JimTxtBrush}" />
                <TextBlock x:Name="PasteText" Foreground="{StaticResource JimT2Brush}"
                           FontSize="13" TextWrapping="Wrap" />
                <TextBox x:Name="ProfileIdBox" />
                <PasswordBox x:Name="OwnerTokenBox" />
                <Button x:Name="LinkButton" Click="OnLink" />
            </StackPanel>

            <StackPanel x:Name="ConsentPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="MayKnowHeading" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource JimTxtBrush}" />
                <TextBlock x:Name="UntilTickText" Foreground="{StaticResource JimT2Brush}"
                           FontSize="13" TextWrapping="Wrap" />
                <StackPanel x:Name="CategoryList" Spacing="4" />

                <TextBlock x:Name="ExactlyHeading" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource JimTxtBrush}" />
                <TextBlock x:Name="BriefText" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource JimTxtBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageItselfText" Foreground="{StaticResource JimT2Brush}"
                           FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="SendButton" Click="OnBrief" />

                <TextBlock x:Name="StopHeading" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource JimTxtBrush}" />
                <TextBlock x:Name="UnlinkNoteText" Foreground="{StaticResource JimT2Brush}"
                           FontSize="13" TextWrapping="Wrap" />
                <Button x:Name="UnlinkButton" Click="OnUnlink" />
            </StackPanel>

            <TextBlock x:Name="NoteText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource JimT2Brush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
