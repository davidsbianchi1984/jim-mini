<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.PresencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Sub" Foreground="{StaticResource JimT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />

            <!-- Honest before warm: what it will not be is rendered above any
                 friendly line, and above the day. This product enrols
                 children, and a guardian should be able to read the refusal
                 without scrolling for it. -->
            <TextBlock x:Name="WhatHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Says" Foreground="{StaticResource JimTxtBrush}"
                       FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="WillNotHead" Foreground="{StaticResource JimT2Brush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="Boundaries" Foreground="{StaticResource JimT3Brush}"
                       FontSize="11" TextWrapping="Wrap" />

            <TextBlock x:Name="TodayHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="OfflineNote" Foreground="{StaticResource JimT3Brush}"
                       FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="Beats" Foreground="{StaticResource JimTxtBrush}"
                       FontSize="13" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="HearButton" Click="OnHear" />
                <Button x:Name="DeepenButton" Click="OnDeepen" />
            </StackPanel>

            <TextBlock x:Name="BaselineHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Areas" Foreground="{StaticResource JimT2Brush}"
                       FontSize="12" TextWrapping="Wrap" />

            <TextBlock x:Name="SurfacesHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="SurfaceRule" Foreground="{StaticResource JimT3Brush}"
                       FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="SurfaceRows" Foreground="{StaticResource JimT2Brush}"
                       FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="SurfaceName" Width="180" />
                <Button x:Name="ChooseButton" Click="OnChooseSurface" />
            </StackPanel>

            <TextBlock x:Name="ReachHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Offers" Foreground="{StaticResource JimT2Brush}"
                       FontSize="12" TextWrapping="Wrap" />

            <TextBlock x:Name="GrowthHead" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock x:Name="Growth" Foreground="{StaticResource JimT3Brush}"
                       FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
