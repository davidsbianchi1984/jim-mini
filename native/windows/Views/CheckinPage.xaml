<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.CheckinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" />
            <TextBlock Text="A quick pulse on how you're doing."
                       Foreground="{StaticResource JimT2Brush}" FontSize="13" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="12">
                    <Slider x:Name="Mood" Header="Mood" Minimum="1" Maximum="5" Value="3"
                            StepFrequency="1" TickFrequency="1" TickPlacement="Outside" />
                    <Slider x:Name="Energy" Header="Energy" Minimum="1" Maximum="5" Value="3"
                            StepFrequency="1" TickFrequency="1" TickPlacement="Outside" />
                    <TextBox x:Name="NoteBox" Header="Note" PlaceholderText="Anything on your mind?"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                </StackPanel>
            </Border>

            <Button x:Name="LogButton" Content="Log check-in" Height="46" HorizontalAlignment="Stretch"
                    Foreground="White" Click="OnLog">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <Border x:Name="GuidanceCard" Background="{StaticResource JimCardBrush}"
                    BorderBrush="{StaticResource JimLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="Guidance" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="GuidanceText" Foreground="{StaticResource JimTxtBrush}"
                               FontSize="14" TextWrapping="Wrap" />
                    <TextBlock x:Name="GuidanceRefs" Foreground="{StaticResource JimGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The wellness protocols sit with the pulse they steady. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CalmHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="CalmPitch" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="CalmTiles" Spacing="4" />
                    <StackPanel x:Name="CalmSteps" Spacing="2" />
                    <TextBlock x:Name="CalmNote" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <StackPanel x:Name="CalmHistory" Spacing="2" />

                    <TextBlock x:Name="WorkHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <Slider x:Name="WorkMinutes" Minimum="5" Maximum="90" Value="20"
                            StepFrequency="5" />
                    <ComboBox x:Name="WorkLevel" HorizontalAlignment="Stretch" SelectedIndex="0" />
                    <TextBox x:Name="WorkFocus" Text="mobility" />
                    <Button x:Name="WorkBuildButton" Click="OnBuildWorkout" Foreground="White"
                            Background="{StaticResource JimBrandABrush}" />
                    <StackPanel x:Name="WorkBlocks" Spacing="2" />

                    <TextBlock x:Name="MealHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource JimTxtBrush}" />
                    <ComboBox x:Name="MealGoal" HorizontalAlignment="Stretch" SelectedIndex="2" />
                    <Slider x:Name="MealDays" Minimum="1" Maximum="7" Value="2" StepFrequency="1" />
                    <Button x:Name="MealPlanButton" Click="OnPlanMeals" Foreground="White"
                            Background="{StaticResource JimBrandABrush}" />
                    <TextBlock x:Name="MealShape" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <StackPanel x:Name="MealDaysList" Spacing="2" />
                    <TextBlock x:Name="MealDisclaimer" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT3Brush}" />
                    <TextBlock x:Name="WelError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimRedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
