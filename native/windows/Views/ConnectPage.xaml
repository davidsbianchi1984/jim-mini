<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource JimTxtBrush}">

        <!-- Sources: consented data feeds -->
        <PivotItem x:Name="SourcesPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SourcesTitle" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="SourcesSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="SourcesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource JimTxtBrush}" />
                                            <ToggleSwitch Grid.Column="1" IsOn="{Binding Consented}"
                                                          Tag="{Binding Source}" Toggled="OnSourceToggled"
                                                          OnContent="" OffContent="" Margin="0,-4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Two guardians, working together and never on the
                         line. It opens only between people who are already
                         each other's contacts, and the half shown is what
                         *this* guardian said. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LiaisonHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="LiaisonLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="LiaisonOther" />
                            <Button x:Name="LiaisonOpenButton" Click="OnOpenLiaison" />
                            <StackPanel x:Name="LiaisonPanel" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <!-- Everywhere the monitoring plugs in. The rows that
                         sense other people carry that on their face, and
                         switching one on says the people in that space have
                         been told. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MonitorsHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MonitorsLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <StackPanel x:Name="MonitorsPanel" Spacing="6" />
                            <!-- What those monitors took in, and what
                                 survived. The drops are here too, each with
                                 the promise that dropped it. -->
                            <!-- What the rooms noticed, read as the content
                                 passes rather than out of anything kept. -->
                            <!-- Two people on one call, each with their own
                                 channel 2. A disclosure and nothing else. -->
                            <TextBlock x:Name="PairHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="PairLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="PairState" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="PairWith" />
                            <Button x:Name="PairGo" Click="OnPairMic" />
                            <Button x:Name="PairEnd" Click="OnUnpairMic"
                                    Visibility="Collapsed" />
                            <TextBlock x:Name="CuesHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="CuesLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <StackPanel x:Name="CuesPanel" Spacing="6" />
                            <TextBlock x:Name="DayHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <StackPanel x:Name="DayPanel" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <!-- An aid on a call other people can hear. The notice
                         goes first: this hands back the words, and nothing
                         listens until they have been played. The number is
                         read for the language and is not kept. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CallHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="CallLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="CallNumber" />
                            <Button x:Name="CallOpenButton" Click="OnOpenCall" />
                            <StackPanel x:Name="CallNotice" Spacing="4" Visibility="Collapsed">
                                <TextBlock x:Name="CallPlayHead" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT2Brush}" />
                                <StackPanel x:Name="CallSay" Spacing="2" />
                                <TextBlock x:Name="CallFrom" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT2Brush}" />
                                <Button x:Name="CallPlayedButton" Click="OnCallAnnounced" />
                                <Button x:Name="CallListenButton" Click="OnCallHeard" />
                                <Button x:Name="CallEndButton" Click="OnEndCall" />
                            </StackPanel>
                            <StackPanel x:Name="CallHistory" Spacing="2" />
                        </StackPanel>
                    </Border>

                    <!-- Channel 2 sits with the sources: the lent microphone
                         is a way in for the world's sound, consented the same. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MicHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <StackPanel x:Name="MicAttachForm" Spacing="8">
                                <TextBlock x:Name="MicNone" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT3Brush}" />
                                <TextBox x:Name="MicDevice" />
                                <ComboBox x:Name="MicKind" HorizontalAlignment="Stretch" />
                                <Button x:Name="MicAttachButton" Click="OnAttachMic"
                                        Background="{StaticResource JimBrandABrush}"
                                        Foreground="White" FontSize="12" />
                            </StackPanel>
                            <StackPanel x:Name="MicAttached" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="MicLine" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource JimTxtBrush}" />
                                <TextBlock x:Name="MicHears" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimT2Brush}" />
                                <TextBlock x:Name="MicCapped" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource JimAmberBrush}" Visibility="Collapsed" />
                                <ComboBox x:Name="MicGain" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnMicGainPicked" />
                                <TextBox x:Name="MicHandoverReason" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="MicHandoverButton" Click="OnHandOverMic"
                                            Background="{StaticResource JimBrandABrush}"
                                            Foreground="White" FontSize="12" />
                                    <Button x:Name="MicReleaseButton" Click="OnReleaseMic"
                                            FontSize="12" Visibility="Collapsed" />
                                    <Button x:Name="MicDetachButton" Click="OnDetachMic"
                                            Background="{StaticResource JimRedBrush}"
                                            Foreground="White" FontSize="12" />
                                </StackPanel>
                                <!-- Where what the worn microphone picked up
                                     reaches the Guardian. The capture belongs
                                     on the device wearing it; this carries the
                                     words for a wearable that relays through
                                     this machine. Shown only while the channel
                                     is live. -->
                                <TextBox x:Name="MicHeardSaid" Visibility="Collapsed" />
                                <Button x:Name="MicHeardButton" Click="OnMicHeard"
                                        Background="{StaticResource JimBrandABrush}"
                                        Foreground="White" FontSize="12"
                                        Visibility="Collapsed" />
                                <TextBlock x:Name="MicHeardBack" FontSize="12"
                                           Foreground="{StaticResource JimT2Brush}"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="MicHistoryButton" Click="OnMicHistory" FontSize="11" />
                            <ItemsControl x:Name="MicHistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" FontSize="11"
                                                   Foreground="{StaticResource JimT2Brush}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MicError" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- The deployment's own plumbing: the voice it speaks
                         in and the mail it sends through. Keys and the
                         password are write-only. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="VsHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="VsStatus" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <!-- The allowance. A spent one used to be
                                 invisible: the send is refused, this shell
                                 falls back to the device's own voice on any
                                 non-ok status, and the Guardian went on
                                 talking in a flatter voice with nobody told
                                 why. Collapsed when there is none to show. -->
                            <TextBlock x:Name="VsQuota" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}"
                                       Visibility="Collapsed" />
                            <StackPanel x:Name="VsProviders" Orientation="Horizontal" Spacing="6" />
                            <StackPanel x:Name="VsVoices" Spacing="4" />
                            <PasswordBox x:Name="VsKey" />
                            <CheckBox x:Name="VsHear" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="VsSaveButton" Click="OnVoiceSave" />
                                <Button x:Name="VsResetButton" Click="OnVoiceReset"
                                        Foreground="{StaticResource JimRedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="VsError" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- The voice pair itself: say it aloud, and talk back.
                         No speaking service is a posture, not a fault — the
                         device's own voice answers and the card says so. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TalkTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBox x:Name="TalkText" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TalkSpeakButton" Click="OnSpeakAloud"
                                        Background="{StaticResource JimBrandABrush}" Foreground="White" />
                                <Button x:Name="TalkMicButton" Click="OnTalkMic"
                                        Background="Transparent" FontSize="12"
                                        Foreground="{StaticResource JimBrandABrush}" />
                            </StackPanel>
                            <TextBlock x:Name="TalkDeviceSpoke" FontSize="11" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="TalkMicRefused" FontSize="11" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimAmberBrush}" />
                            <TextBlock x:Name="TalkHeard" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="TalkHealth" FontSize="10" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="TalkError" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="MlHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="MlStatus" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBox x:Name="MlHost" />
                            <NumberBox x:Name="MlPort" Value="587" Minimum="1" Maximum="65535" />
                            <TextBox x:Name="MlUser" />
                            <PasswordBox x:Name="MlPass" />
                            <TextBox x:Name="MlFrom" />
                            <TextBox x:Name="MlLink" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MlSaveButton" Click="OnMailSave" />
                                <Button x:Name="MlResetButton" Click="OnMailReset"
                                        Foreground="{StaticResource JimRedBrush}" />
                            </StackPanel>
                            <TextBox x:Name="MlTestTo" />
                            <Button x:Name="MlTestButton" Click="OnMailTest" />
                            <TextBlock x:Name="MlTestNote" FontSize="11" Visibility="Collapsed"
                                       Foreground="{StaticResource JimGreenBrush}" />
                            <TextBlock x:Name="MlError" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimRedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- The wrist's drip channel and the paired embodiments
                         are sources too. -->
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WtHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="WtLead" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <StackPanel x:Name="WtDevices" Orientation="Horizontal" Spacing="6" />
                            <TextBlock x:Name="WtAddressLabel" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="WtAddress" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="WtDrips" FontSize="10"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="WtDripBox" Width="120" FontSize="11" />
                                <Button x:Name="WtDripButton" Click="OnWatchDrip" FontSize="11" />
                            </StackPanel>
                            <TextBlock x:Name="WtDripAck" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WtStepsButton" Click="OnWatchSteps" />
                                <Button x:Name="WtRotateButton" Click="OnWatchRotate"
                                        Foreground="{StaticResource JimRedBrush}" />
                                <Button x:Name="WtSeedButton" Click="OnWatchSeed" />
                            </StackPanel>
                            <StackPanel x:Name="WtSteps" Spacing="2" Visibility="Collapsed" />
                            <TextBlock x:Name="WtSeedHint" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="WtPairHow" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="WtPairUrl" FontSize="11" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="WtPairNote" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="WtPairQr" FontSize="10" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="WtError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="DvHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <StackPanel x:Name="DvRows" Spacing="2" />
                            <TextBox x:Name="DvName" />
                            <StackPanel x:Name="DvKinds" Spacing="4" />
                            <CheckBox x:Name="DvPaired" IsChecked="True" />
                            <Button x:Name="DvAddButton" HorizontalAlignment="Stretch"
                                    Click="OnDeviceAdd" />
                            <TextBlock x:Name="DvError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SitHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SitStartButton" Click="OnSitStart" />
                                <Button x:Name="SitEndButton" Click="OnSitEnd" IsEnabled="False"
                                        Background="Transparent" FontSize="12"
                                        Foreground="{StaticResource JimRedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SitLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="SitMemory" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <StackPanel x:Name="SitTurns" Spacing="2" />
                            <TextBlock x:Name="SitNote" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="SitError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource JimRedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Social platform connections -->
        <PivotItem x:Name="SocialPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SocialTitle" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <ComboBox x:Name="PlatformBox" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="HandleBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ConnectCollectButton" Click="OnConnectCollect"
                                        Background="{StaticResource JimBrandABrush}" Foreground="White" />
                                <Button x:Name="ConnectPublishButton" Click="OnConnectPublish"
                                        Background="{StaticResource JimBrandABrush}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SocialError" Foreground="{StaticResource JimRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="SocialStatus" Foreground="{StaticResource JimGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="SocialList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource JimTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Handle}" FontSize="12"
                                                       Foreground="{StaticResource JimT2Brush}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding CollectSampleLabel}" Tag="{Binding Id}" Click="OnCollect"
                                                    Visibility="{Binding CollectVisibility}"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding ScrapeLabel}" Tag="{Binding Id}" Click="OnScrape"
                                                    Visibility="{Binding ScrapeVisibility}"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding PublishUpdateLabel}" Tag="{Binding Id}" Click="OnPublish"
                                                    Visibility="{Binding PublishVisibility}"
                                                    Background="{StaticResource JimBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding BeaconLabel}" Tag="{Binding Id}" Click="OnSocialBeacon"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimBrandABrush}" />
                                            <Button Content="{Binding DisconnectLabel}" Tag="{Binding Id}" Click="OnSocialDisconnect"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimRedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding QrLine}" FontSize="10" IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" Foreground="{StaticResource JimT3Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Connected-apps catalog -->
        <PivotItem x:Name="AppsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="AppsTitle" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="AppsSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="CatalogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{StaticResource JimTxtBrush}" />
                                                <TextBlock Text="{Binding Provider}" FontSize="11"
                                                           Foreground="{StaticResource JimT2Brush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ConnectLabel}" Tag="{Binding Key}"
                                                    Click="OnAppConnect" VerticalAlignment="Center"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimBrandABrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AppsError" Foreground="{StaticResource JimRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="AppsStatus" Foreground="{StaticResource JimGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="AppConnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource JimTxtBrush}" />
                                        <Button Grid.Column="1" Content="{Binding CollectLabel}" Tag="{Binding Id}"
                                                Click="OnAppCollect" Background="Transparent" FontSize="12"
                                                Foreground="{StaticResource JimBrandABrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- The community door (FIG. 2 boxes 222-226) -->
        <PivotItem x:Name="CommunityPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CommunityTitle" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="CommunityNote" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="CommunityLanguage" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT3Brush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PostureTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <!-- Rendered from the server's own booleans rather than
                                 retyped as reassurance, so this cannot drift from
                                 what the bridge actually does. -->
                            <ItemsControl x:Name="PostureList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource JimT2Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="RoomsTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="RoomsEmpty" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT3Brush}" />
                            <ItemsControl x:Name="RoomList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource JimTxtBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource JimT3Brush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding OpenLabel}" Tag="{Binding Id}"
                                                    Click="OnOpenRoom" VerticalAlignment="Center"
                                                    Visibility="{Binding OpenVisibility}"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimBrandABrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="NearTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="PlacesEmpty" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <ItemsControl x:Name="PlaceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource JimTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Listings}" FontSize="12"
                                                       Foreground="{StaticResource JimT2Brush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="AskTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBox x:Name="AskTopicBox" FontSize="12" />
                            <TextBox x:Name="AskQuestionBox" FontSize="12" />
                            <Button x:Name="AskGoButton" Click="OnStartExcursion"
                                    Background="{StaticResource JimBrandABrush}" Foreground="White" />
                            <ItemsControl x:Name="ExcursionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Topic}"
                                                           Foreground="{StaticResource JimTxtBrush}" />
                                                <!-- Redactions, colored by whether the question
                                                     left this host. The price line below says
                                                     what the number and the color mean. -->
                                                <TextBlock Text="{Binding Redactions}" FontSize="11"
                                                           Foreground="{Binding HostBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ReadLabel}" Tag="{Binding Id}"
                                                    Click="OnReadExcursion" VerticalAlignment="Center"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimBrandABrush}" />
                                            <Button Grid.Column="2" Content="{Binding KeepLabel}" Tag="{Binding Id}"
                                                    Click="OnKeepExcursion" VerticalAlignment="Center"
                                                    IsEnabled="{Binding KeepEnabled}"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource JimBrandABrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ExcursionEntryText" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="ExcursionLearnedText" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimGreenBrush}" />
                            <TextBlock x:Name="AskPrice" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT3Brush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="VisitsLine" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource JimT2Brush}" />
                            <ItemsControl x:Name="VisitList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" FontSize="11"
                                                   Foreground="{StaticResource JimT3Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FeedTitle" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource JimTxtBrush}" />
                            <TextBlock x:Name="FeedRefused" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="FeedNote" FontSize="12" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT2Brush}" />
                            <TextBlock x:Name="FeedCannotPost" FontSize="11" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource JimT3Brush}" />
                            <TextBlock x:Name="FeedEmpty" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource JimT3Brush}" />
                            <ItemsControl x:Name="FeedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" FontSize="12"
                                                   Foreground="{StaticResource JimT2Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="OpenInQrmeButton" Click="OnOpenFeedInQrme" Visibility="Collapsed"
                                    Background="Transparent" FontSize="12"
                                    Foreground="{StaticResource JimBrandABrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VisitStatus" FontSize="12" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource JimGreenBrush}" />
                    <TextBlock x:Name="CommunityError" FontSize="13" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource JimRedBrush}" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
