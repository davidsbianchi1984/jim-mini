<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JimGuardian.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource JimScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="440" Spacing="20" Padding="24,40" HorizontalAlignment="Center">
            <Ellipse Width="84" Height="84" HorizontalAlignment="Center">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="HeroText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource JimTxtBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="PitchLine"
                       FontSize="13" Foreground="{StaticResource JimT2Brush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />

            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="12">
                    <TextBox x:Name="NameBox" />
                    <TextBox x:Name="BirthBox" Text="1984-01-01" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="ConsentBox"
                              Foreground="{StaticResource JimTxtBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="By enrolling you agree to the Terms of Service — JIM-mini is a wellness tool, not a medical device; in an emergency call 911 first. You assume the risks of AI guidance and monitoring. Full terms: GET /terms · docs/terms.md"
                       Foreground="{StaticResource JimT2Brush}" FontSize="10" TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource JimRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Button x:Name="StartButton" HorizontalAlignment="Stretch"
                    Height="46" Foreground="White" Click="OnStart">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource JimBrandA}" Offset="0" />
                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>


            <!-- Or a real account: email-verified, recoverable, and the same
                 one the console and the other devices share. -->
            <Border Background="{StaticResource JimCardBrush}" BorderBrush="{StaticResource JimLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ModeUpButton" Click="OnModeUp" FontSize="12" />
                        <Button x:Name="ModeInButton" Click="OnModeIn" FontSize="12" />
                        <Button x:Name="ModeResetButton" Click="OnModeReset" FontSize="12" />
                    </StackPanel>
                    <TextBox x:Name="AccountEmailBox" />
                    <TextBox x:Name="AccountNameBox" />
                    <PasswordBox x:Name="AccountPasswordBox" />
                    <CheckBox x:Name="AccountConsentBox"
                              Foreground="{StaticResource JimTxtBrush}" />
                    <TextBlock x:Name="ResetHint" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="VerifyHint" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBox x:Name="AccountCodeBox" Visibility="Collapsed" PlaceholderText="123456" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AccountGoButton" Click="OnAccountGo" Foreground="White"
                                Background="{StaticResource JimBrandABrush}" />
                        <Button x:Name="ResendButton" Click="OnResend" Visibility="Collapsed"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                        <Button x:Name="ResetSendButton" Click="OnResetSend" Visibility="Collapsed"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource JimBrandABrush}" />
                    </StackPanel>
                    <StackPanel x:Name="OauthDoors" Spacing="6" />
                    <TextBlock x:Name="AccountNotice" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimT2Brush}" />
                    <TextBlock x:Name="AccountError" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource JimRed}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Start the backend:  JIM_CORS_ORIGINS=* uvicorn jim.api:app"
                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource JimT2Brush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
