# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local databases & secrets — never commit runtime data
*.db
*.db-shm
*.db-wal
*.sqlite3
.env
.env.*

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Gradle's own working directories. The wear module's wrapper is committed
# (gradlew, gradlew.bat and gradle-wrapper.jar) so a fresh clone can build
# without Gradle installed first — but everything Gradle writes while
# running is not ours to keep.
.gradle/
